# Rosetta Code: https://rosettacode.org/wiki/99_bottles_of_beer
99 D "
  c
  d D 1 = ? '1 bottle' ]
  d 1 = ~ ? d a ' bottles' C ]
  ' of beer on the wall, ' C p
  d D 1 = ? '1 bottle' ]
  d 1 = ~ ? d a ' bottles' C ]
  ' of beer.' C p
  'Take one down and pass it around, ' p
  d 1 - c
  d D 0 = ? 'No more bottles' ]
  d 0 = ~ ?
    d D 1 = ? '1 bottle' ]
    d 1 = ~ ? d a ' bottles' C ]
  ]
  ' of beer on the wall.' C p
  '' p
  d
" x
